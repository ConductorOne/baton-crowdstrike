{
  "info": {
    "name": "baton-crowdstrike Test Server",
    "description": "Collection for testing the baton-crowdstrike connector against the local mock of the CrowdStrike Falcon user-management API.\n\nStart the test server with: `go run ./test-server/` (listens on https://127.0.0.1:8443 with a self-signed cert).\n\nIn Postman, disable SSL certificate verification (Settings > General > SSL certificate verification: OFF) because the server uses a self-signed certificate.\n\nCredentials (the mock accepts any value):\n- client_id: test\n- client_secret: test\n- Bearer token: test-access-token\n\nSeed data:\n- Roles: falcon_administrator, falcon_analyst, falcon_read_only\n- Users: alice@example.com (admin), bob@example.com (analyst + read-only)\n\nRun \"Get OAuth Token\" first; it stores the access token in the {{accessToken}} variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get OAuth Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.access_token);",
                  "pm.test('Token received', function () {",
                  "    pm.expect(json.access_token).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth2/token",
              "host": ["{{baseUrl}}"],
              "path": ["oauth2", "token"]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "client_secret", "value": "{{clientSecret}}", "type": "text" },
                { "key": "grant_type", "value": "client_credentials", "type": "text" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Query User IDs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/user-management/queries/users/v1?limit=500&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["user-management", "queries", "users", "v1"],
              "query": [
                { "key": "limit", "value": "500" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Query User ID by email (FQL filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/user-management/queries/users/v1?filter=uid:'alice@example.com'&limit=1",
              "host": ["{{baseUrl}}"],
              "path": ["user-management", "queries", "users", "v1"],
              "query": [
                { "key": "filter", "value": "uid:'alice@example.com'" },
                { "key": "limit", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Retrieve User Details",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/user-management/entities/users/GET/v1",
              "host": ["{{baseUrl}}"],
              "path": ["user-management", "entities", "users", "GET", "v1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\"{{userUuid}}\"]\n}"
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/user-management/entities/users/v1",
              "host": ["{{baseUrl}}"],
              "path": ["user-management", "entities", "users", "v1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"carol@example.com\",\n  \"first_name\": \"Carol\",\n  \"last_name\": \"Carter\"\n}"
            }
          }
        },
        {
          "name": "Update User (first/last name)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/user-management/entities/users/v1?user_uuid={{userUuid}}",
              "host": ["{{baseUrl}}"],
              "path": ["user-management", "entities", "users", "v1"],
              "query": [{ "key": "user_uuid", "value": "{{userUuid}}" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Alice\",\n  \"last_name\": \"Anderson\"\n}"
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/user-management/entities/users/v1?user_uuid={{userUuid}}",
              "host": ["{{baseUrl}}"],
              "path": ["user-management", "entities", "users", "v1"],
              "query": [{ "key": "user_uuid", "value": "{{userUuid}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Query Role IDs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/user-management/queries/roles/v1",
              "host": ["{{baseUrl}}"],
              "path": ["user-management", "queries", "roles", "v1"]
            }
          }
        },
        {
          "name": "Get Role Details by IDs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/user-management/entities/roles/v1?ids={{roleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user-management", "entities", "roles", "v1"],
              "query": [{ "key": "ids", "value": "{{roleId}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "User Roles",
      "item": [
        {
          "name": "List User Roles (grants)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/user-management/combined/user-roles/v1?user_uuid={{userUuid}}&limit=500&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["user-management", "combined", "user-roles", "v1"],
              "query": [
                { "key": "user_uuid", "value": "{{userUuid}}" },
                { "key": "limit", "value": "500" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Grant Role to User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/user-roles/entities/user-roles/v1?user_uuid={{userUuid}}",
              "host": ["{{baseUrl}}"],
              "path": ["user-roles", "entities", "user-roles", "v1"],
              "query": [{ "key": "user_uuid", "value": "{{userUuid}}" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleIds\": [\"{{roleId}}\"]\n}"
            }
          }
        },
        {
          "name": "Revoke Role from User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/user-roles/entities/user-roles/v1?user_uuid={{userUuid}}&ids={{roleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user-roles", "entities", "user-roles", "v1"],
              "query": [
                { "key": "user_uuid", "value": "{{userUuid}}" },
                { "key": "ids", "value": "{{roleId}}" }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://127.0.0.1:8443", "type": "string" },
    { "key": "accessToken", "value": "test-access-token", "type": "string" },
    { "key": "clientId", "value": "test", "type": "string" },
    { "key": "clientSecret", "value": "test", "type": "string" },
    { "key": "userUuid", "value": "11111111-1111-1111-1111-111111111111", "type": "string" },
    { "key": "roleId", "value": "falcon_read_only", "type": "string" }
  ]
}
